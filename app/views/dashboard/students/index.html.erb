<% content_for :page_title, "Student Search" %>
<% content_for :page_subtitle, "Find and view detailed information for any student" %>

<div class="bg-gray-50 min-h-full" data-controller="student-list">
  <!-- Search Section -->
  <div class="bg-white rounded-lg shadow p-6 mb-6">
    <div class="mb-6">
      <label class="block text-sm font-medium text-gray-700 mb-2">Search Students</label>
      <div class="relative">
        <input 
          type="text" 
          data-student-list-target="searchInput"
          data-action="keypress->student-list#handleKeypress"
          placeholder="Search by name or email" 
          class="w-full px-4 py-3 pl-11 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent text-base">
        <svg class="w-5 h-5 text-gray-400 absolute left-3 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>
    </div>

    <!-- Filters -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Cohort</label>
        <select 
          data-student-list-target="cohortFilter"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
          <option value="">All Cohorts</option>
          <% Cohort.order(:name).each do |cohort| %>
            <option value="<%= cohort.id %>"><%= cohort.name %></option>
          <% end %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Risk Level</label>
        <select 
          data-student-list-target="riskFilter"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
          <option value="">All Risk Levels</option>
          <option value="high">High Risk (90-100)</option>
          <option value="medium">Medium Risk (75-90)</option>
          <option value="low">Low Risk (0-75)</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Engagement</label>
        <select 
          data-student-list-target="engagementFilter"
          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
          <option value="">All Levels</option>
          <option value="high">High (85-100%)</option>
          <option value="medium">Medium (50-85%)</option>
          <option value="low">Low (0-50%)</option>
        </select>
      </div>
    </div>

    <div class="mt-4 flex gap-2">
      <button 
        data-action="click->student-list#search"
        class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 font-medium">
        Search
      </button>
      <button 
        data-action="click->student-list#clearFilters"
        class="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium">
        Clear Filters
      </button>
    </div>
  </div>

  <!-- Empty State -->
  <div data-student-list-target="emptyState" class="bg-white rounded-lg shadow p-12 text-center">
    <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <h3 class="text-lg font-semibold text-gray-900 mb-2">Search for Students</h3>
    <p class="text-gray-600">Enter a name, email, or apply filters to find students</p>
  </div>

  <!-- Results Section -->
  <div data-student-list-target="resultsSection" class="bg-white rounded-lg shadow hidden">
    <div class="p-4 sm:p-6 border-b border-gray-200 flex items-center justify-between">
      <div>
        <h3 class="text-lg font-semibold text-gray-800">Search Results</h3>
      </div>
      <div>
        <label class="block text-xs font-medium text-gray-500 mb-1">Sort by</label>
        <select 
          data-student-list-target="orderFilter" 
          data-action="change->student-list#handleOrderChange"
          class="px-3 py-1.5 text-sm border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-transparent">
          <option value="">Default</option>
          <option value="engagement_desc">Engagement (High to Low)</option>
          <option value="engagement_asc">Engagement (Low to High)</option>
          <option value="risk_desc">Risk Score (High to Low)</option>
          <option value="risk_asc">Risk Score (Low to High)</option>
          <option value="last_active_desc">Recently Active</option>
          <option value="last_active_asc">Least Active</option>
        </select>
      </div>
    </div>
    
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student</th>
            <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Cohort</th>
            <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap">Engagement</th>
            <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap">Risk Score</th>
            <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase hidden sm:table-cell">Last Active</th>
            <th class="px-4 sm:px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
          </tr>
        </thead>
        <tbody data-student-list-target="resultsBody" class="divide-y divide-gray-200">
        </tbody>
      </table>
    </div>

    <!-- Loading State -->
    <div data-student-list-target="loadingState" class="hidden p-8 text-center">
      <div class="inline-block w-8 h-8 border-4 border-indigo-600 border-t-transparent rounded-full animate-spin"></div>
      <p class="text-sm text-gray-500 mt-2">Loading students...</p>
    </div>

    <!-- Pagination -->
    <div data-student-list-target="paginationControls" class="hidden flex items-center justify-between px-4 sm:px-6 py-4 border-t border-gray-200">
      <button 
        data-student-list-target="prevBtn"
        data-action="click->student-list#prevPage"
        class="px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium hover:bg-gray-50 disabled:opacity-50 disabled:cursor-not-allowed">
        Previous
      </button>
      <div class="text-sm text-gray-600">
        Page <span data-student-list-target="pageNumber">1</span>
      </div>
      <button 
        data-student-list-target="nextBtn"
        data-action="click->student-list#nextPage"
        class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm font-medium hover:bg-indigo-700 disabled:opacity-50 disabled:cursor-not-allowed">
        Next
      </button>
    </div>
  </div>
</div>
