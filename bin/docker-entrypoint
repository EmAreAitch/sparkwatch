#!/bin/bash -e

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
  ./bin/rails runner "Rails.application.load_seed unless Activity.exists?(created_at: Date.current.last_week.beginning_of_day..)"
fi

exec "${@}"
